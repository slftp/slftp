# Default: normalize text files and use LF in the repository/checkout.
* text=auto eol=lf

# Windows-specific scripts/projects.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.dproj text eol=crlf
*.dpr text eol=crlf
*.dfm text eol=crlf
*.groupproj text eol=crlf
*.rc text eol=crlf

# Common text formats (explicit for clarity).
*.pas text eol=lf
*.lpr text eol=lf
*.inc text eol=lf
*.lpi text eol=lf
*.lfm text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.sh text eol=lf
*.pl text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.svg text eol=lf
*.patch text eol=lf

# Binary artifacts (tracked in repo / third-party).
*.a binary
*.o binary
*.obj binary
*.lib binary
*.zip binary
*.png binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
